# Copy to .env (gitignored) and fill in your keys. Never commit the real .env.

# TTS engine keys (Gemini is the primary engine; leave GEMINI_API_KEY empty to
# fall back to the free edge-tts engine).
GEMINI_API_KEY=

# LLM text preparation (speaker tagging / voice cast). Without it the reader
# falls back to plain single-voice narration.
MISTRAL_API_KEY=

# Reserved for a possible Google Cloud TTS adapter (not implemented; the plan
# says to skip Cloud TTS unless a benchmark shows it beats Gemini).
GOOGLE_TTS_KEY=

# App settings (the Docker image/compose file already set the data dir).
# TTSEREADER_DATA_DIR=/data
# TTSEREADER_DEFAULT_ENGINE=gemini
